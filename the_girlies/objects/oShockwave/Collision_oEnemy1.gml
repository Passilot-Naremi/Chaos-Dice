if(oPlayerSayo.ultprog < 100){	/// @DnDAction : YoYo Games.Common.Variable
	/// @DnDVersion : 1
	/// @DnDHash : 63E52A48
	/// @DnDParent : 5FCD0217
	/// @DnDArgument : "expr" "1"
	/// @DnDArgument : "expr_relative" "1"
	/// @DnDArgument : "var" "oPlayerSayo.ultprog"
	oPlayerSayo.ultprog += 1;}