	/// @DnDParent : 55E491AD
	/// @DnDArgument : "expr" "2"
	/// @DnDArgument : "expr_relative" "1"
	/// @DnDArgument : "var" "oPlayerDeku.ultprog"
	oPlayerDeku.ultprog += 2;}